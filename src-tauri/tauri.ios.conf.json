{
  "$schema": "https://schema.tauri.app/config/2",
  "identifier": "app.hghub.personal",
  "build": {
    "beforeBuildCommand": "pnpm build && python3 scripts/build-remux-ios.py"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "HGViewer"
      }
    ]
  },
  "bundle": {
    "targets": "all",
    "iOS": {
      "minimumSystemVersion": "17.1",
      "bundleVersion": "1.2.24",
      "frameworks": [
        "../build/remux/HGRemux.xcframework"
      ]
    },
    "resources": {
      "native/remux/COPYING.LGPLv2.1": "FFmpeg-LICENSE.txt"
    }
  }
}
